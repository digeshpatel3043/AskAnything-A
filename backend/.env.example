# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# Required. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model name (change if Google retires/renames models)
GEMINI_MODEL=gemini-2.5-flash

# SQLite for local development (default).
# For production (e.g. Supabase) use a PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./askanything.db

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds to wait for Gemini before returning a friendly timeout message
REQUEST_TIMEOUT_SECONDS=60

# Limits
MAX_MESSAGE_CHARS=8000
MAX_CONTEXT_MESSAGES=30
MAX_BODY_BYTES=100000
